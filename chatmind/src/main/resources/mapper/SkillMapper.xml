<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kama.chatmind.mapper.SkillMapper">

    <resultMap id="BaseResultMap" type="com.kama.chatmind.model.entity.Skill">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="description" column="description" jdbcType="VARCHAR"/>
        <result property="tools" column="tools" jdbcType="VARCHAR"/>
        <result property="triggerKeywords" column="trigger_keywords" jdbcType="VARCHAR"/>
        <result property="promptTemplate" column="prompt_template" jdbcType="VARCHAR"/>
        <result property="createdAt" column="created_at" jdbcType="TIMESTAMP"/>
        <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,name,description,
        tools,trigger_keywords,prompt_template,
        created_at,updated_at
    </sql>

    <insert id="insert" parameterType="com.kama.chatmind.model.entity.Skill"
            keyColumn="id" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO skill
        (name,
         description,
         tools,
         trigger_keywords,
         prompt_template,
         created_at,
         updated_at)
        VALUES (#{name},
                #{description},
                CAST(#{tools} AS jsonb),
                CAST(#{triggerKeywords} AS jsonb),
                #{promptTemplate},
                #{createdAt},
                #{updatedAt})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT id,
               name,
               description,
               tools::text          AS tools,
               trigger_keywords::text AS trigger_keywords,
               prompt_template,
               created_at,
               updated_at
        FROM skill
        WHERE id = CAST(#{id} AS uuid)
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT id,
               name,
               description,
               tools::text          AS tools,
               trigger_keywords::text AS trigger_keywords,
               prompt_template,
               created_at,
               updated_at
        FROM skill
        ORDER BY created_at DESC
    </select>

    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT id,
               name,
               description,
               tools::text          AS tools,
               trigger_keywords::text AS trigger_keywords,
               prompt_template,
               created_at,
               updated_at
        FROM skill
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            CAST(#{id} AS uuid)
        </foreach>
        ORDER BY created_at DESC
    </select>

    <delete id="deleteById">
        DELETE
        FROM skill
        WHERE id = CAST(#{id} AS uuid)
    </delete>

    <update id="updateById" parameterType="com.kama.chatmind.model.entity.Skill">
        UPDATE skill
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
            <if test="tools != null">
                tools = CAST(#{tools} AS jsonb),
            </if>
            <if test="triggerKeywords != null">
                trigger_keywords = CAST(#{triggerKeywords} AS jsonb),
            </if>
            <if test="promptTemplate != null">
                prompt_template = #{promptTemplate},
            </if>
            updated_at = NOW()
        </set>
        WHERE id = CAST(#{id} AS uuid)
    </update>
</mapper>
